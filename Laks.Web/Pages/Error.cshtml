@page
@model ErrorModel
@{
    ViewData["Title"] = "Fejl";
}

<div class="ed-section">
    <h1 class="ed-section-title">Der opstod en fejl</h1>
    <p class="ed-empty">Der opstod en fejl under behandling af din forespørgsel. Prøv igen, eller gå tilbage til <a asp-page="/Index">forsiden</a>.</p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Forespørgsels-ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
