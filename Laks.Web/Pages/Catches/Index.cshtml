@page
@model Laks.Web.Pages.Catches.IndexModel
@{
    ViewData["Title"] = "Fangster";
    var da = System.Globalization.CultureInfo.GetCultureInfo("da-DK");
}

<div class="ed-page-header">
    <h1 class="ed-section-title">Fangstlog</h1>
    <a asp-page="/Statistics/Index" class="ed-action-link">Statistik &rarr;</a>
</div>

<div class="ed-filter-bar">
    <form method="get">
        <label for="year" class="ed-form-label">Filtrer efter sæsonår</label>
        <select id="year" name="year" class="ed-form-select" onchange="this.form.submit()">
            <option value="">— Alle sæsoner —</option>
            @foreach (var season in Model.Seasons)
            {
                <option value="@season.Year" selected="@(Model.SelectedYear == season.Year)">
                    @season.Year (@season.TotalCatches fangster)
                </option>
            }
        </select>
        <noscript><button type="submit" class="ed-form-submit">Filtrer</button></noscript>
    </form>
</div>

@if (Model.SelectedSeason != null)
{
    <div class="ed-alert">
        <strong>Sæson @Model.SelectedSeason.Year</strong> —
        @Model.SelectedSeason.TotalCatches fangster, @Model.SelectedSeason.ParticipantCount deltagere
        @if (Model.SelectedSeason.FirstCatchDate.HasValue && Model.SelectedSeason.LastCatchDate.HasValue)
        {
            <span>· @Model.SelectedSeason.FirstCatchDate.Value.ToString("d MMM", System.Globalization.CultureInfo.GetCultureInfo("da-DK")) – @Model.SelectedSeason.LastCatchDate.Value.ToString("d MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("da-DK"))</span>
        }
    </div>
}

@if (Model.CatchList.Any())
{
    <div class="ed-table-wrap">
        <table class="ed-table" aria-label="Fangstlog">
            <caption>@Model.CatchList.Count() fangst(er) vist</caption>
            <thead>
                <tr>
                    <th scope="col">Dato</th>
                    <th scope="col">Tid</th>
                    <th scope="col">År</th>
                    <th scope="col">Fisker</th>
                    <th scope="col">Type</th>
                    <th scope="col" class="ed-td-num">Vægt (kg)</th>
                    <th scope="col">Sted</th>
                    <th scope="col">Vejr</th>
                    <th scope="col" class="ed-td-num">Vandstand (m)</th>
                    <th scope="col">Agn</th>
                    <th scope="col">Noter</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.CatchList)
                {
                    <tr>
                        <td>@c.CatchDate.ToString("d MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("da-DK"))</td>
                        <td>@c.CatchTime.ToString(@"hh\:mm")</td>
                        <td>@c.SeasonYear</td>
                        <td><a class="ed-angler-link" asp-page="/Anglers/Index" asp-route-id="@c.AnglerId">@c.AnglerName</a></td>
                        <td>@c.CatchType</td>
                        <td class="ed-td-num">@c.WeightKg.ToString("F2", da)</td>
                        <td>@c.Location</td>
                        <td>@c.Weather</td>
                        <td class="ed-td-num">@(c.WaterLevel?.ToString("F3", da) ?? "—")</td>
                        <td>@c.Bait</td>
                        <td class="ed-td-muted">@c.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="ed-empty">Ingen fangster fundet for det valgte filter.</p>
}
