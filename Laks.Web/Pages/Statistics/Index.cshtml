@page
@model Laks.Web.Pages.Statistics.IndexModel
@{
    ViewData["Title"] = "Statistik";
}

<div class="ed-page-header">
    <h1 class="ed-section-title">Fiskestatistik</h1>
</div>

<div class="ed-filter-bar">
    <form method="get">
        <label for="year" class="ed-form-label">Filtrer fisker- og typediagrammer efter år</label>
        <select id="year" name="year" class="ed-form-select" onchange="this.form.submit()">
            <option value="">— Alle år —</option>
            @foreach (var season in Model.Seasons)
            {
                <option value="@season.Year" selected="@(Model.SelectedYear == season.Year)">@season.Year</option>
            }
        </select>
    </form>
</div>

<div class="ed-section ed-chart-section">
    <div class="ed-section-title">
        Fangster pr. år (historisk trend)
    </div>
    <figure class="ed-chart-figure">
        <div class="ed-chart-wrap">
            <canvas id="trendChart"></canvas>
        </div>
    </figure>
</div>

<div class="ed-stats-grid">
    <div class="ed-section ed-chart-section">
        <div class="ed-section-title">
            Fangster pr. fisker
            @if (Model.SelectedYear.HasValue) { <span class="ed-badge">@Model.SelectedYear</span> }
        </div>
        <figure class="ed-chart-figure">
            <div class="ed-chart-wrap">
                <canvas id="barChart"></canvas>
            </div>
        </figure>
    </div>

    <div class="ed-section ed-chart-section">
        <div class="ed-section-title">
            Fangsttype-fordeling
            @if (Model.SelectedYear.HasValue) { <span class="ed-badge">@Model.SelectedYear</span> }
        </div>
        <figure class="ed-chart-figure">
            <div class="ed-chart-wrap" style="max-width:360px;margin:0 auto">
                <canvas id="donutChart"></canvas>
            </div>
        </figure>
    </div>
</div>

<div class="ed-section">
    <div class="ed-section-title">
        Største laks pr. hold
        @if (Model.SelectedYear.HasValue) { <span class="ed-badge">@Model.SelectedYear</span> }
    </div>
    @if (Model.TeamStats.Any())
    {
        <div class="ed-stats-grid">
            <div class="ed-chart-section">
                <figure class="ed-chart-figure">
                    <div class="ed-chart-wrap">
                        <canvas id="teamChart"></canvas>
                    </div>
                </figure>
            </div>
            <div class="ed-table-wrap">
                <table class="ed-table" aria-label="Holdstatistik for laks">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Hold</th>
                            <th scope="col" class="ed-td-num">Største (kg)</th>
                            <th scope="col">Fanget af</th>
                            <th scope="col" class="ed-td-num">Laks</th>
                            <th scope="col" class="ed-td-num">Gns. (kg)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rank = 0; }
                        @foreach (var team in Model.TeamStats)
                        {
                            rank++;
                            <tr>
                                <td>@rank</td>
                                <td>@team.TeamName</td>
                                <td class="ed-td-num">@team.BiggestSalmonKg.ToString("N1")</td>
                                <td>@team.AnglerName</td>
                                <td class="ed-td-num">@team.TotalSalmonCount</td>
                                <td class="ed-td-num">@team.AvgSalmonWeightKg.ToString("N1")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <p class="ed-empty">Ingen holddata for laks tilgængelig.</p>
    }
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"
        integrity="sha256-1G2Xof0CLF+yn6L0Xry8MiAtc67r8HbOX3JI9UmPx9c="
        crossorigin="anonymous"></script>
<script>
(function () {
    'use strict';

    Chart.defaults.font.family = "'Inter', system-ui, -apple-system, sans-serif";
    Chart.defaults.font.size   = 13;
    Chart.defaults.color       = '#7a6f60';
    Chart.defaults.borderColor = '#3a3128';

    const PALETTE = [
        '#d97757','#b35d3f','#e8a989','#b8a890','#7a6f60',
        '#f5ede0','#3a3128','#25201a','#1c1814','#a06040'
    ];

    // ① Trend line -------------------------------------------------------
    const trendLabels = @Html.Raw(Model.TrendLabelsJson);
    const trendTotals = @Html.Raw(Model.TrendTotalsJson);
    const trendWeight = @Html.Raw(Model.TrendWeightJson);

    new Chart(document.getElementById('trendChart'), {
        type: 'line',
        data: {
            labels: trendLabels,
            datasets: [
                {
                    label: 'Antal fangster',
                    data: trendTotals,
                    borderColor: '#d97757',
                    backgroundColor: 'rgba(217,119,87,.12)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 5,
                    yAxisID: 'y'
                },
                {
                    label: 'Samlet vægt (kg)',
                    data: trendWeight,
                    borderColor: '#b8a890',
                    backgroundColor: 'rgba(184,168,144,.1)',
                    fill: false,
                    tension: 0.3,
                    pointRadius: 5,
                    borderDash: [5, 3],
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                tooltip: { callbacks: {
                    label: ctx => ctx.datasetIndex === 1
                        ? ` ${ctx.parsed.y.toFixed(1)} kg`
                        : ` ${ctx.parsed.y} fangster`
                }},
                legend: { position: 'top' }
            },
            scales: {
                y:  { type: 'linear', position: 'left',  title: { display: true, text: 'Fangster' } },
                y1: { type: 'linear', position: 'right', title: { display: true, text: 'kg' },
                      grid: { drawOnChartArea: false } }
            }
        }
    });

    // ② Bar: catches per angler ------------------------------------------
    const barLabels  = @Html.Raw(Model.BarLabelsJson);
    const barCatches = @Html.Raw(Model.BarCatchesJson);
    const barWeight  = @Html.Raw(Model.BarWeightJson);

    new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
            labels: barLabels,
            datasets: [
                {
                    label: 'Fangster',
                    data: barCatches,
                    backgroundColor: barLabels.map((_, i) => PALETTE[i % PALETTE.length]),
                    borderRadius: 0
                },
                {
                    label: 'Samlet vægt (kg)',
                    data: barWeight,
                    backgroundColor: 'rgba(184,168,144,.45)',
                    borderRadius: 0,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'top' } },
            scales: {
                y:  { title: { display: true, text: 'Fangster' }, beginAtZero: true },
                y1: { position: 'right', title: { display: true, text: 'kg' },
                      grid: { drawOnChartArea: false }, beginAtZero: true }
            }
        }
    });

    // ③ Donut: catch type distribution ------------------------------------
    const pieLabels = @Html.Raw(Model.PieLabelsJson);
    const pieData   = @Html.Raw(Model.PieDataJson);

    new Chart(document.getElementById('donutChart'), {
        type: 'doughnut',
        data: {
            labels: pieLabels,
            datasets: [{
                data: pieData,
                backgroundColor: PALETTE,
                hoverOffset: 8,
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' },
                tooltip: { callbacks: {
                    label: ctx => {
                        const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                        const pct   = total > 0 ? ((ctx.parsed / total) * 100).toFixed(1) : 0;
                        return ` ${ctx.label}: ${ctx.parsed} (${pct}%)`;
                    }
                }}
            }
        }
    });

    // ④ Team bar: biggest salmons per team --------------------------------
    const teamLabels  = @Html.Raw(Model.TeamLabelsJson);
    const teamBiggest = @Html.Raw(Model.TeamBiggestJson);
    const teamAvg     = @Html.Raw(Model.TeamAvgWeightJson);

    if (teamLabels.length > 0) {
        new Chart(document.getElementById('teamChart'), {
            type: 'bar',
            data: {
                labels: teamLabels,
                datasets: [
                    {
                        label: 'Største laks (kg)',
                        data: teamBiggest,
                        backgroundColor: '#d97757',
                        borderRadius: 0,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Gns. laksevægt (kg)',
                        data: teamAvg,
                        backgroundColor: 'rgba(184,168,144,.45)',
                        borderRadius: 0,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' },
                    tooltip: { callbacks: {
                        label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y.toFixed(1)} kg`
                    }}
                },
                scales: {
                    y:  { title: { display: true, text: 'Største (kg)' }, beginAtZero: true },
                    y1: { position: 'right', title: { display: true, text: 'Gns. (kg)' },
                          grid: { drawOnChartArea: false }, beginAtZero: true }
                }
            }
        });
    }
}());
</script>
}
