@model Laks.Web.Pages.IndexModel
@{
    var da = System.Globalization.CultureInfo.GetCultureInfo("da-DK");
}
<section class="ed-section" aria-labelledby="leaderboard-title">
    <h2 id="leaderboard-title" class="ed-section-title">Sæsontavlen <span class="ed-kicker">Top</span></h2>

    <div class="ed-lb-controls" role="group" aria-label="Rangliste-omfang">
        <a class="ed-pill @(Model.LeaderboardScope == "my-group" ? "is-active" : "")"
           asp-page="/Index"
           asp-route-leaderboardScope="my-group"
           asp-route-groupNumber="@Model.GroupNumber">Mit hold</a>
        <a class="ed-pill @(Model.LeaderboardScope == "all-groups" ? "is-active" : "")"
           asp-page="/Index"
           asp-route-leaderboardScope="all-groups">Alle hold @Model.CurrentYear</a>
        <a class="ed-pill @(Model.LeaderboardScope == "last-year" ? "is-active" : "")"
           asp-page="/Index"
           asp-route-leaderboardScope="last-year">Sidste år</a>
    </div>

    @if (Model.AvailableGroups.Count > 1 && Model.LeaderboardScope == "my-group")
    {
        <div class="ed-lb-controls" role="group" aria-label="Vælg hold">
            <span class="ed-lb-group-label">Hold</span>
            @foreach (var g in Model.AvailableGroups)
            {
                <a class="ed-pill @(g.GroupNumber == Model.SelectedGroup ? "is-active" : "")"
                   asp-page="/Index"
                   asp-route-leaderboardScope="my-group"
                   asp-route-groupNumber="@g.GroupNumber">@g.GroupNumber</a>
            }
        </div>
    }

    @if (!Model.Leaderboard.Any())
    {
        <div class="ed-lb-empty">Ingen rangliste-data tilgængelig.</div>
    }
    else
    {
        <div>
            @foreach (var item in Model.Leaderboard)
            {
                <div class="ed-lb-row">
                    <span class="ed-lb-rank">@item.Rank</span>
                    <span class="ed-lb-name">@item.AnglerName</span>
                    <div class="ed-lb-stats">
                        <span class="ed-lb-weight">@item.TotalWeightKg.ToString("F1", da) kg</span>
                        @item.FishCount fisk · bedste @item.BestWeightKg.ToString("F1", da) kg
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.GroupSummaries.Count > 0)
    {
        <div class="ed-lb-groups">
            @for (var i = 0; i < Model.GroupSummaries.Count; i++)
            {
                var group = Model.GroupSummaries[i];
                var isSel = group.GroupNumber == Model.SelectedGroup;
                <span class="@(isSel ? "is-selected" : "")">Hold @group.GroupNumber (@group.Label): @group.FishCount fisk / @group.TotalWeightKg.ToString("F1", da) kg</span>
                if (i < Model.GroupSummaries.Count - 1)
                {
                    <span> · </span>
                }
            }
        </div>
    }
</section>
