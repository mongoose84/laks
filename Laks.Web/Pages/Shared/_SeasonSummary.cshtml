@model Laks.Web.Pages.IndexModel
@{
    var da = System.Globalization.CultureInfo.GetCultureInfo("da-DK");
}
<section class="ed-section" aria-labelledby="season-summary-title">
    <h2 id="season-summary-title" class="ed-section-title">Sæsonen i tal <span class="ed-kicker">Oversigt</span></h2>
    @if (Model.CurrentSeasonSummary is null)
    {
        <div class="ed-catch-empty">Sæsonoversigt ikke tilgængelig.</div>
    }
    else
    {
        <div class="ed-conditions-grid">
            <article class="ed-condition-card">
                <div class="ed-condition-label">Fisk i alt</div>
                <div class="ed-condition-value">@Model.CurrentSeasonSummary.TotalFish</div>
            </article>
            <article class="ed-condition-card">
                <div class="ed-condition-label">Total kg</div>
                <div class="ed-condition-value">@Model.CurrentSeasonSummary.TotalWeightKg.ToString("F1", da)</div>
            </article>
            <article class="ed-condition-card">
                <div class="ed-condition-label">Gns. kg</div>
                <div class="ed-condition-value">@Model.CurrentSeasonSummary.AvgWeightKg.ToString("F1", da)</div>
            </article>
            <article class="ed-condition-card">
                <div class="ed-condition-label">Største (@Model.CurrentSeasonSummary.BiggestFishAngler)</div>
                <div class="ed-condition-value">@Model.CurrentSeasonSummary.BiggestFishKg.ToString("F1", da)</div>
            </article>
            <article class="ed-condition-card">
                <div class="ed-condition-label">Aktive fiskere</div>
                <div class="ed-condition-value">@Model.CurrentSeasonSummary.ActiveAnglers / @Model.CurrentSeasonSummary.TotalAnglers</div>
            </article>
        </div>
    }
</section>
