@model Laks.Web.Pages.IndexModel
<section class="ed-section" aria-labelledby="catch-map-title">
    <h2 id="catch-map-title" class="ed-section-title">
        Fangstkort
        <span class="ed-lb-controls" role="group" aria-label="Vælg kortoversigt">
            <button type="button" id="mapScopeSeason" class="ed-pill is-active" aria-pressed="true">Denne sæson</button>
            <button type="button" id="mapScopeAll" class="ed-pill" aria-pressed="false">Vis alt</button>
        </span>
    </h2>
    <div class="ed-map-frame">
        <div id="catchMap"
             class="ed-catch-map"
             role="application"
             aria-label="Fangststeder ved Holmfoss på Numedalslågen"></div>
        <div id="catchMapEmpty" class="ed-map-empty d-none">Ingen fangststeder at vise.</div>
    </div>
</section>
