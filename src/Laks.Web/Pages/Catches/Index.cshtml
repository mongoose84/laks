@page
@model Laks.Web.Pages.Catches.IndexModel
@{
    ViewData["Title"] = "Catches";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">🐟 Catch Log</h1>
    <a asp-page="/Statistics/Index" class="btn btn-outline-primary btn-sm">Statistics &raquo;</a>
</div>

<!-- Season filter -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-4">
                <label for="year" class="form-label fw-semibold">Filter by season year</label>
                <select id="year" name="year" class="form-select" onchange="this.form.submit()">
                    <option value="">— All seasons —</option>
                    @foreach (var season in Model.Seasons)
                    {
                        <option value="@season.Year" selected="@(Model.SelectedYear == season.Year)">
                            @season.Year (@season.TotalCatches catches)
                        </option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedSeason != null)
{
    <div class="alert alert-info">
        <strong>Season @Model.SelectedSeason.Year</strong> –
        @Model.SelectedSeason.TotalCatches catches, @Model.SelectedSeason.ParticipantCount participants
        @if (Model.SelectedSeason.FirstCatchDate.HasValue && Model.SelectedSeason.LastCatchDate.HasValue)
        {
            <span>| @Model.SelectedSeason.FirstCatchDate.Value.ToString("d MMM") – @Model.SelectedSeason.LastCatchDate.Value.ToString("d MMM yyyy")</span>
        }
    </div>
}

@if (Model.CatchList.Any())
{
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle caption-top">
            <caption>@Model.CatchList.Count() catch(es) shown</caption>
            <thead class="table-primary">
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Year</th>
                    <th>Angler</th>
                    <th>Type</th>
                    <th class="text-end">Weight (kg)</th>
                    <th>Location</th>
                    <th>Weather</th>
                    <th>Water level</th>
                    <th>Bait</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.CatchList)
                {
                    <tr>
                        <td>@c.CatchDate.ToString("d MMM yyyy")</td>
                        <td>@c.CatchTime.ToString(@"hh\:mm")</td>
                        <td>@c.SeasonYear</td>
                        <td>@c.AnglerName</td>
                        <td>@c.CatchType</td>
                        <td class="text-end fw-semibold">@c.WeightKg.ToString("F2")</td>
                        <td>@c.Location</td>
                        <td>@c.Weather</td>
                        <td>@(c.WaterLevel?.ToString("F3") ?? "—")</td>
                        <td>@c.Bait</td>
                        <td class="text-muted small">@c.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">No catches found for the selected filter.</div>
}
