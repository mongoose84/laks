@page
@model Laks.Web.Pages.Catches.IndexModel
@{
    ViewData["Title"] = "Catches";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">🐟 Catch Log</h1>
    <a asp-page="/Statistics/Index" class="btn btn-outline-primary btn-sm">Statistics &raquo;</a>
</div>

<!-- Trip filter -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-4">
                <label for="tripId" class="form-label fw-semibold">Filter by trip year</label>
                <select id="tripId" name="tripId" class="form-select" onchange="this.form.submit()">
                    <option value="">— All trips —</option>
                    @foreach (var trip in Model.Trips)
                    {
                        <option value="@trip.Id" selected="@(Model.SelectedTripId == trip.Id)">
                            @trip.Year – @trip.RiverName (@trip.TotalCatches catches)
                        </option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedTrip != null)
{
    <div class="alert alert-info">
        <strong>Trip @Model.SelectedTrip.Year</strong> –
        @Model.SelectedTrip.RiverName, @Model.SelectedTrip.Location |
        @Model.SelectedTrip.StartDate.ToString("d MMM") – @Model.SelectedTrip.EndDate.ToString("d MMM yyyy")
    </div>
}

@if (Model.CatchList.Any())
{
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle caption-top">
            <caption>@Model.CatchList.Count() catch(es) shown</caption>
            <thead class="table-primary">
                <tr>
                    <th>Date</th>
                    <th>Year</th>
                    <th>Angler</th>
                    <th>Species</th>
                    <th class="text-end">Weight (kg)</th>
                    <th class="text-end">Length (cm)</th>
                    <th>River</th>
                    <th>Released</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.CatchList)
                {
                    <tr>
                        <td>@c.CatchDate.ToString("d MMM yyyy")</td>
                        <td>@c.TripYear</td>
                        <td>@c.AnglerName</td>
                        <td>@c.SpeciesName</td>
                        <td class="text-end fw-semibold">@c.WeightKg.ToString("F2")</td>
                        <td class="text-end">@c.LengthCm.ToString("F1")</td>
                        <td>@c.RiverName</td>
                        <td class="text-center">@(c.Released ? "✅" : "❌")</td>
                        <td class="text-muted small">@c.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">No catches found for the selected filter.</div>
}
