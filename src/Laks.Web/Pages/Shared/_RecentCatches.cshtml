@model Laks.Web.Pages.IndexModel
@{
    static string RelativeTime(DateTime date)
    {
        var now = DateTime.UtcNow;
        var diff = now - date.ToUniversalTime();
        if (diff.TotalHours < 1)
        {
            var minutes = Math.Max(1, (int)Math.Round(diff.TotalMinutes));
            return $"{minutes} min ago";
        }

        if (diff.TotalHours < 24)
        {
            var hours = Math.Max(1, (int)Math.Round(diff.TotalHours));
            return $"{hours} hours ago";
        }

        if (diff.TotalDays < 2)
        {
            return "Yesterday";
        }

        var days = Math.Max(1, (int)Math.Round(diff.TotalDays));
        return $"{days} days ago";
    }
}

<section class="card shadow-sm mb-3" aria-labelledby="recent-catches-title">
    <header class="card-header d-flex justify-content-between align-items-center">
        <h2 id="recent-catches-title" class="h5 mb-0">Recent Catches</h2>
        <a asp-page="/Catches/Index">View all catches</a>
    </header>
    <div class="card-body">
        @if (!Model.RecentCatches.Any())
        {
            <div class="text-muted">No catches yet this season.</div>
        }
        else
        {
            <div class="recent-catch-list">
                @foreach (var c in Model.RecentCatches)
                {
                    var initials = string.Join(string.Empty, (c.AnglerName ?? string.Empty)
                        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Select(n => n[0])
                        .Take(2))
                        .ToUpperInvariant();

                    <article class="recent-catch-item">
                        <div class="initials-circle">@initials</div>
                        <div>
                            <div class="fw-semibold">
                                @c.AnglerName · <strong>@c.WeightKg.ToString("F1") kg</strong> @c.CatchType
                            </div>
                            <div class="small text-muted">@c.Location · @RelativeTime(c.CatchDate)</div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
