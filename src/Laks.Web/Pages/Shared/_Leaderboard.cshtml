@model Laks.Web.Pages.IndexModel

<section class="card shadow-sm mb-3" aria-labelledby="leaderboard-title">
    <header class="card-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 id="leaderboard-title" class="h5 mb-0">Season Leaderboard</h2>
            <div class="btn-group" role="group" aria-label="Leaderboard scope">
                <a class="btn btn-sm @(Model.LeaderboardScope == "my-group" ? "btn-primary" : "btn-outline-primary")"
                   asp-page="/Index"
                   asp-route-leaderboardScope="my-group"
                   asp-route-groupNumber="@Model.GroupNumber">My Group</a>
                <a class="btn btn-sm @(Model.LeaderboardScope == "all-groups" ? "btn-primary" : "btn-outline-primary")"
                   asp-page="/Index"
                   asp-route-leaderboardScope="all-groups">All Groups @Model.CurrentYear</a>
                <a class="btn btn-sm @(Model.LeaderboardScope == "last-year" ? "btn-primary" : "btn-outline-primary")"
                   asp-page="/Index"
                   asp-route-leaderboardScope="last-year">Last Year</a>
            </div>
        </div>
    </header>
    <div class="card-body p-0">
        @if (!Model.Leaderboard.Any())
        {
            <div class="p-3 text-muted">No leaderboard data available.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 leaderboard-table">
                    <caption class="visually-hidden">Leaderboard table for selected period</caption>
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Angler</th>
                            <th scope="col" class="text-end">Fish</th>
                            <th scope="col" class="text-end">Total kg</th>
                            <th scope="col" class="text-end">Best kg</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Leaderboard)
                        {
                            var medal = item.Rank switch
                            {
                                1 => "🥇",
                                2 => "🥈",
                                3 => "🥉",
                                _ => item.Rank.ToString()
                            };

                            <tr>
                                <td>@medal</td>
                                <td>@item.AnglerName</td>
                                <td class="text-end">@item.FishCount</td>
                                <td class="text-end">@item.TotalWeightKg.ToString("F1")</td>
                                <td class="text-end">@item.BestWeightKg.ToString("F1")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.GroupSummaries.Count > 0)
    {
        <footer class="card-footer small">
            @foreach (var group in Model.GroupSummaries)
            {
                <span class="@(group.GroupNumber == Model.SelectedGroup ? "fw-bold" : "")">
                    Group @group.GroupNumber (@group.Label): @group.FishCount fish / @group.TotalWeightKg.ToString("F1") kg
                </span>
                if (group != Model.GroupSummaries.Last())
                {
                    <span class="mx-1">·</span>
                }
            }
        </footer>
    }
</section>
