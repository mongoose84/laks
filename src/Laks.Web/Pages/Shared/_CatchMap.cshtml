@model Laks.Web.Pages.IndexModel

<section class="card shadow-sm mb-3" aria-labelledby="catch-map-title">
    <header class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h2 id="catch-map-title" class="h5 mb-0">Fangstkort</h2>
        <div class="btn-group btn-group-sm" role="group" aria-label="Vælg kortoversigt">
            <button type="button" id="mapScopeSeason" class="btn btn-primary">Denne sæson</button>
            <button type="button" id="mapScopeAll" class="btn btn-outline-primary">Alle tider</button>
        </div>
    </header>
    <div class="card-body">
        <div id="catchMap"
             class="catch-map"
             role="application"
             aria-label="Fangststeder ved Holmfoss på Numedalslågen"></div>
        <div id="catchMapEmpty" class="small text-muted mt-2 d-none">Ingen fangststeder at vise.</div>
    </div>
</section>
