@model Laks.Web.Pages.IndexModel

<section class="card shadow-sm mb-3" aria-label="Sæsonoversigt">
    <div class="card-body">
        @if (Model.CurrentSeasonSummary is null)
        {
            <div class="text-muted">Sæsonoversigt ikke tilgængelig.</div>
        }
        else
        {
            <div class="laks-season-strip">
                <div class="summary-cell">
                    <div class="summary-value">@Model.CurrentSeasonSummary.TotalFish</div>
                    <div class="summary-label">Fisk i alt</div>
                </div>
                <div class="summary-cell">
                    <div class="summary-value">@Model.CurrentSeasonSummary.TotalWeightKg.ToString("F1")</div>
                    <div class="summary-label">Total kg</div>
                </div>
                <div class="summary-cell">
                    <div class="summary-value">@Model.CurrentSeasonSummary.AvgWeightKg.ToString("F1")</div>
                    <div class="summary-label">Gns. kg</div>
                </div>
                <div class="summary-cell">
                    <div class="summary-value">@Model.CurrentSeasonSummary.BiggestFishKg.ToString("F1")</div>
                    <div class="summary-label">Største (@Model.CurrentSeasonSummary.BiggestFishAngler)</div>
                </div>
                <div class="summary-cell">
                    <div class="summary-value">@Model.CurrentSeasonSummary.ActiveAnglers / @Model.CurrentSeasonSummary.TotalAnglers</div>
                    <div class="summary-label">Aktive fiskere</div>
                </div>
                <div class="summary-cell">
                    <div class="summary-value">@Model.SeasonDay.DisplayText</div>
                    <div class="summary-label">Sæsondag</div>
                </div>
            </div>
        }
    </div>
</section>
