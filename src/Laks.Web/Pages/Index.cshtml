@page
@model IndexModel
@{
    ViewData["Title"] = "Forside";
}

<div class="laks-dashboard-page">
    <partial name="_ConditionsStrip" model="Model" />
    <partial name="_WaterLevelChart" model="Model" />
    <partial name="_Leaderboard" model="Model" />
    <partial name="_CatchMap" model="Model" />
    <partial name="_RecentCatches" model="Model" />
    <partial name="_SeasonSummary" model="Model" />
    <partial name="_AllTimeRecords" model="Model" />
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"
            integrity="sha256-1G2Xof0CLF+yn6L0Xry8MiAtc67r8HbOX3JI9UmPx9c="
            crossorigin="anonymous"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script>
        window.laksDashboard = {
            waterLevelSeries: @Html.Raw(Model.WaterLevelChartJson),
            currentSeasonLocations: @Html.Raw(Model.CatchLocationsCurrentSeasonJson),
            allTimeLocations: @Html.Raw(Model.CatchLocationsAllTimeJson),
            trend: "@Model.CurrentWaterLevel?.Trend.ToString().ToLowerInvariant()"
        };
    </script>
    <script src="~/js/water-level-chart.js" asp-append-version="true"></script>
    <script src="~/js/catch-map.js" asp-append-version="true"></script>
}
